{
  "name": "pinball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulación de pinball con librería de física propia (Física I, FUN-18, Universidad CENFOTEC)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.physics.json",
    "headless": "tsx scripts/headless.ts"
  },
  "dependencies": {
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}